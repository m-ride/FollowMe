VITE_API_URL=http://localhost:8081/api
# Solo para dev local: te salta el candado y usa este token directo. NO la definas
# en el build de producción (Vercel) — ahí el candado (gate.ts) es la única entrada,
# y el código se guarda solo en localStorage de quien lo escribe, nunca en el bundle.
VITE_APP_TOKEN=dev
VITE_NOMBRE=tú
VITE_PAREJA_NOMBRE=tu pareja
